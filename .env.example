# Copy this file to .env for local testing. Never commit .env or passwords.
# Production: set these in your API host's secret/environment settings.

STORAGE_MODE=github
GITHUB_REPO=YOUR-USERNAME/YOUR-PRIVATE-DATA-REPOSITORY
GITHUB_BRANCH=main
GITHUB_DB_PATH=data/helpline.sqlite3
GITHUB_TOKEN=REPLACE-WITH-FINE-GRAINED-TOKEN

# Replace ALL example values. Use a different password for every operator.
USERS_JSON={"operator1":"REPLACE-WITH-A-LONG-UNIQUE-PASSWORD"}
SESSION_SECRET=REPLACE-WITH-A-RANDOM-SECRET-OF-AT-LEAST-32-CHARACTERS

# Website origins only: no repository paths and no trailing slash.
# For https://YOUR-USERNAME.github.io/helpline/ use https://YOUR-USERNAME.github.io
ALLOWED_ORIGINS=https://YOUR-USERNAME.github.io,http://localhost:8000,http://127.0.0.1:8000
HOST=127.0.0.1
PORT=8000

# To test without GitHub, set STORAGE_MODE=local above.
# Optional: SQLITE_PATH=data/helpline.sqlite3
